# App
APP_URL=http://localhost:3000
AUTH_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repairrelay

# Demo accounts: used only by the seed script when DEMO_MODE=true
DEMO_MODE=true
DEMO_SEED_PASSWORD=

# AI: provider must support image input and schema-constrained JSON output
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=30000

# Channel3 — keep this key server-side
CHANNEL3_API_KEY=
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD
CHANNEL3_LANGUAGE=en
CHANNEL3_SEARCH_MODE=default
CHANNEL3_REQUEST_TIMEOUT_MS=12000

# PayPal — sandbox only for the hackathon
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
# Webhooks are intentionally NOT used: the app reconciles payment state via
# provider reads (docs/architecture/API-CONTRACTS.md §9), so no webhook id is needed.

# Uploaded device/evidence images. Local private driver (implemented in
# src/lib/storage) is sufficient for local judging; the StorageAdapter interface
# supports swapping in an object-storage driver if the app is ever deployed.
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./data/uploads
MAX_UPLOAD_BYTES=8388608
