// RepairRelay — Prisma schema (S1 slice: identity foundation).
// Domain scopes propose owned model changes via reviewed patches; integrator owns this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SIMULATED_REPAIRER
  DEMO_ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  displayName  String
  passwordHash String
  role         UserRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disabledAt   DateTime?

  repairRequests RepairRequest[]
  simulatedRepairer SimulatedRepairer?

  @@map("users")
}

enum RepairStatus {
  DRAFT
  INTAKE_SUBMITTED
  DIAGNOSIS_PENDING
  DIAGNOSIS_READY
  DIAGNOSIS_INCONCLUSIVE
  DIAGNOSIS_FAILED
  PARTS_SEARCH_PENDING
  PARTS_AVAILABLE
  PARTS_EMPTY
  PARTS_SEARCH_FAILED
  QUOTES_PENDING
  QUOTES_AVAILABLE
  CONTRACT_SELECTED
  CONTRACT_APPROVED
  REPAIR_IN_PROGRESS
  EVIDENCE_SUBMITTED
  CUSTOMER_REVIEW
  REWORK_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeviceModelConfidence {
  USER_SELECTED
  AI_SUGGESTED
  UNKNOWN
}

enum RepairCategory {
  DISPLAY_REPLACEMENT
  BATTERY_REPLACEMENT
  CHARGING_PORT_REPLACEMENT
  CAMERA_REPLACEMENT
  DIAGNOSTIC_ONLY
  OTHER
}

enum AssetKind {
  INTAKE
  BEFORE
  AFTER
  COMPONENT
  OTHER
}

enum ConfidenceBand {
  LOW
  MEDIUM
  HIGH
  UNASSESSED
}

model RepairRequest {
  id                     String                @id @default(uuid())
  publicReference        String                @unique
  customerId             String
  customer               User                  @relation(fields: [customerId], references: [id])
  deviceBrand            String
  deviceModel            String
  modelIdentifier        String?
  deviceModelConfidence  DeviceModelConfidence @default(USER_SELECTED)
  symptoms               String
  repairCategory         RepairCategory?
  status                 RepairStatus          @default(DRAFT)
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  assets          UploadedAsset[]
  diagnosisReports DiagnosisReport[]
  searchRuns      ProductSearchRun[]

  selectedCandidateId       String?
  selectedChannel3ProductId String?
  selectedQuoteId           String?

  quotes   RepairQuote[]
  contract RepairContract?
  jobs     RepairJob[]

  @@index([customerId])
  @@map("repair_requests")
}

enum JobStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_EVIDENCE
  CUSTOMER_REVIEW
  REWORK_REQUESTED
  REWORK_IN_PROGRESS
  ACCEPTED
  CANCEL_REQUESTED
  CANCELLED
}

enum EvidenceStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
}

enum EvidenceAssetType {
  BEFORE
  AFTER
  COMPONENT_LABEL
  OTHER
}

enum ComponentIdentityBasis {
  LABEL_PHOTO
  TECHNICIAN_DECLARATION
  OTHER
}

model RepairJob {
  id                  String         @id @default(uuid())
  repairRequestId     String         @unique
  repairRequest       RepairRequest  @relation(fields: [repairRequestId], references: [id])
  contractId          String
  contractVersionId   String
  repairerId          String
  status              JobStatus      @default(NOT_STARTED)
  startedAt           DateTime?
  evidenceSubmittedAt DateTime?
  acceptedAt          DateTime?
  cancelledAt         DateTime?
  reworkCount         Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  submissions EvidenceSubmission[]
  decisions   CustomerDecision[]

  @@index([repairerId])
  @@map("repair_jobs")
}

model EvidenceSubmission {
  id                     String                  @id @default(uuid())
  repairJobId            String
  repairJob              RepairJob               @relation(fields: [repairJobId], references: [id])
  contractVersionId      String
  submittedBy            String
  status                 EvidenceStatus          @default(DRAFT)
  componentDeclaration   String
  componentIdentityBasis ComponentIdentityBasis
  functionalChecksJson   Json
  notes                  String?
  submittedAt            DateTime?
  createdAt              DateTime                @default(now())

  assets      EvidenceAsset[]
  assessments EvidenceAssessment[]

  @@index([repairJobId])
  @@map("evidence_submissions")
}

model EvidenceAsset {
  id             String            @id @default(uuid())
  submissionId   String
  submission     EvidenceSubmission @relation(fields: [submissionId], references: [id])
  uploadedAssetId String
  evidenceType   EvidenceAssetType
  caption        String?
  createdAt      DateTime          @default(now())

  @@index([submissionId])
  @@map("evidence_assets")
}

/// Advisory only — never treated as customer acceptance or payment eligibility.
model EvidenceAssessment {
  id             String   @id @default(uuid())
  submissionId   String
  submission     EvidenceSubmission @relation(fields: [submissionId], references: [id])
  provider       String
  model          String
  schemaVersion  Int
  completeness   String
  flags          Json
  reasoningSummary String
  createdAt      DateTime @default(now())

  @@index([submissionId])
  @@map("evidence_assessments")
}

enum DecisionType {
  ACCEPT
  REQUEST_REWORK
  CANCEL
}

/// Immutable. One decision per evidence submission (unique); rework creates a new
/// submission and a new decision. Accept/cancel payment orchestration runs through S04.
model CustomerDecision {
  id                   String       @id @default(uuid())
  repairJobId          String
  repairJob            RepairJob    @relation(fields: [repairJobId], references: [id])
  evidenceSubmissionId String      @unique
  contractVersionId    String
  customerId           String
  decision             DecisionType
  comment              String?
  createdAt            DateTime     @default(now())

  @@index([repairJobId])
  @@map("customer_decisions")
}

enum ContractStatus {
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  CHANGE_REQUESTED
  COMPLETED
  CANCEL_REQUESTED
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

model RepairContract {
  id              String         @id @default(uuid())
  repairRequestId String         @unique
  repairRequest   RepairRequest  @relation(fields: [repairRequestId], references: [id])
  selectedQuoteId String
  /// Plain reference to the active ContractVersion id (kept without an FK to avoid
  /// a circular relation; the authoritative pointer is the highest approved version).
  currentVersionId String?
  status          ContractStatus @default(AWAITING_CUSTOMER_APPROVAL)
  version         Int            @default(1)
  currency        String         @default("USD")
  totalMinor      Int
  approvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  versions       ContractVersion[]
  changeRequests ContractChangeRequest[]
  paymentAttempts PaymentAttempt[]

  @@map("repair_contracts")
}

enum PaymentProvider {
  PAYPAL
}

enum ProviderEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentStatus {
  NOT_CREATED
  ORDER_CREATE_PENDING
  ORDER_CREATED
  BUYER_APPROVAL_PENDING
  BUYER_CANCELLED
  AUTHORIZATION_PENDING
  AUTHORIZED
  AUTHORIZATION_DECLINED
  AUTHORIZATION_UNKNOWN
  AUTHORIZATION_EXPIRED
  CAPTURE_PENDING
  CAPTURED
  CAPTURE_FAILED
  CAPTURE_UNKNOWN
  VOID_PENDING
  VOIDED
  VOID_FAILED
  VOID_UNKNOWN
}

enum PaymentOperationType {
  CREATE_ORDER
  AUTHORIZE
  CAPTURE
  VOID
  RECONCILE
}

enum PaymentOperationStatus {
  STARTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

model PaymentAttempt {
  id                       String              @id @default(uuid())
  repairContractId         String
  contract                 RepairContract      @relation(fields: [repairContractId], references: [id])
  contractVersionId        String
  provider                 PaymentProvider     @default(PAYPAL)
  providerEnvironment      ProviderEnvironment @default(SANDBOX)
  currency                 String
  amountMinor              Int
  status                   PaymentStatus       @default(NOT_CREATED)
  paypalOrderId            String?             @unique
  paypalAuthorizationId    String?             @unique
  paypalCaptureId          String?             @unique
  rawOrderStatus           String?
  rawAuthorizationStatus   String?
  rawCaptureStatus         String?
  authorizationExpiresAt   DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  operations PaymentOperation[]

  @@index([repairContractId])
  @@map("payment_attempts")
}

model PaymentOperation {
  id                       String                @id @default(uuid())
  paymentAttemptId         String
  attempt                  PaymentAttempt        @relation(fields: [paymentAttemptId], references: [id])
  operationType            PaymentOperationType
  idempotencyKey           String                @unique
  status                   PaymentOperationStatus @default(STARTED)
  requestHash              String?
  providerRequestId        String?
  providerResponseRedacted Json?
  errorCode                String?
  startedAt                DateTime              @default(now())
  completedAt              DateTime?

  @@index([paymentAttemptId])
  @@map("payment_operations")
}

/// Immutable after insert (except approval metadata recorded as separate decision fields).
model ContractVersion {
  id                            String         @id @default(uuid())
  contractId                    String
  contract                      RepairContract @relation(fields: [contractId], references: [id])
  versionNumber                 Int
  quoteSnapshotJson             Json
  /// Repair-versus-Replace mode: historical replacement-device comparison snapshot
  /// (labelled as observed-at-creation; never a current offer or a repair part).
  productReferenceSnapshotJson  Json?
  scopeSnapshot                 String
  warrantySnapshot              String
  totalMinor                    Int
  currency                      String
  changeReason                  String?
  createdBy                     String
  createdAt                     DateTime       @default(now())
  customerApprovedAt            DateTime?
  supersededAt                  DateTime?

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@map("contract_versions")
}

model ContractChangeRequest {
  id                String             @id @default(uuid())
  contractId        String
  contract          RepairContract     @relation(fields: [contractId], references: [id])
  fromVersionId     String
  proposedVersionId String
  requestedBy       String
  requestedByRole   String
  reason            String
  status            ChangeRequestStatus @default(PENDING)
  customerDecisionAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([contractId])
  @@map("contract_change_requests")
}

/// Seeded demo actor. demoLabel is fixed to SIMULATED — never presented as a real technician.
model SimulatedRepairer {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  displayName     String
  demoLabel       String   @default("SIMULATED")
  demoDescription String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  quotes RepairQuote[]

  @@map("simulated_repairers")
}

enum QuoteStatus {
  GENERATED
  SELECTED
  SUPERSEDED
  EXPIRED
}

/// Attestation is explicitly simulation data: the seeded actor selected a value,
/// not independent technical verification (PRODUCT-SPEC §6.5).
enum CompatibilityAttestation {
  CONFIRMED_FOR_DEMO
  NOT_CONFIRMED
  REJECTED
}

/// Itemized quote snapshot. Repair-versus-Replace mode: the component is
/// technician-declared — there is no Channel3 part reference on a quote.
model RepairQuote {
  id                      String                  @id @default(uuid())
  repairRequestId         String
  repairRequest           RepairRequest           @relation(fields: [repairRequestId], references: [id])
  repairerId              String
  repairer                SimulatedRepairer       @relation(fields: [repairerId], references: [id])
  version                 Int                     @default(1)
  status                  QuoteStatus             @default(GENERATED)
  componentLabel          String
  compatibilityAttestation CompatibilityAttestation
  compatibilityNotes      String
  partChargeMinor         Int
  labourMinor             Int
  feesMinor               Int                     @default(0)
  taxMinor                Int                     @default(0)
  totalMinor              Int
  currency                String                  @default("USD")
  warrantyDays            Int?
  warrantyText            String
  estimatedDurationHours  Int?
  scopeText               String
  exclusionsText          String
  validUntil              DateTime
  createdAt               DateTime                @default(now())

  @@unique([repairRequestId, repairerId, version])
  @@index([repairRequestId])
  @@map("repair_quotes")
}

enum SearchRunStatus {
  SUCCEEDED
  EMPTY
  FAILED
}

enum OfferAvailability {
  InStock
  OutOfStock
  UNKNOWN
}

enum OfferCondition {
  new
  used
  refurbished
  UNKNOWN
}

/// Search execution record. Query/result metadata only — never a stale-offer cache.
model ProductSearchRun {
  id                   String          @id @default(uuid())
  repairRequestId      String
  repairRequest        RepairRequest   @relation(fields: [repairRequestId], references: [id])
  provider             String          @default("CHANNEL3")
  query                String
  country              String
  currency             String
  language             String
  mode                 String
  providerRequestId    String?
  status               SearchRunStatus
  resultCount          Int
  normalizationVersion Int
  errorCode            String?
  createdAt            DateTime        @default(now())
  completedAt          DateTime?

  candidates ProductCandidate[]

  @@index([repairRequestId])
  @@map("product_search_runs")
}

/// Stable external reference. No offer price/availability/URL stored here as catalog data.
model ProductCandidate {
  id                String          @id @default(uuid())
  searchRunId       String
  searchRun         ProductSearchRun @relation(fields: [searchRunId], references: [id])
  channel3ProductId String
  title             String
  description       String?
  brandNames        Json?
  imageUrl          String?
  createdAt         DateTime        @default(now())

  offerObservations OfferObservation[]

  @@unique([searchRunId, channel3ProductId])
  @@index([channel3ProductId])
  @@map("product_candidates")
}

/// Short-lived observation of an offer at a point in time. Never served after expiresAt.
model OfferObservation {
  id                String           @id @default(uuid())
  productCandidateId String
  productCandidate  ProductCandidate @relation(fields: [productCandidateId], references: [id])
  domain            String
  offerUrl          String
  priceMinor        Int?
  currency          String?
  availability      OfferAvailability @default(UNKNOWN)
  condition         OfferCondition   @default(UNKNOWN)
  observedAt        DateTime
  expiresAt         DateTime

  @@index([productCandidateId])
  @@map("offer_observations")
}

model UploadedAsset {
  id             String    @id @default(uuid())
  repairRequestId String
  repairRequest  RepairRequest @relation(fields: [repairRequestId], references: [id])
  ownerId        String
  assetKind      AssetKind
  storageKey     String    @unique
  mimeType       String
  byteSize       Int
  width          Int
  height         Int
  sha256         String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([repairRequestId])
  @@map("uploaded_assets")
}

model DiagnosisReport {
  id                      String          @id @default(uuid())
  repairRequestId         String
  repairRequest           RepairRequest   @relation(fields: [repairRequestId], references: [id])
  provider                String
  model                   String
  schemaVersion           Int
  deviceModelAssessment   Json
  visibleObservations     Json
  suspectedCauses         Json
  likelyRepairCategory    String?
  confidenceBand          ConfidenceBand
  unknowns                Json
  recommendedQuestions    Json
  limitations             Json
  rawOutputRedacted       String?
  createdAt               DateTime        @default(now())
  supersededAt            DateTime?

  @@index([repairRequestId])
  @@map("diagnosis_reports")
}

/// Append-only by application convention. No secrets, card data, raw images or full PII.
model AuditEvent {
  id                     String   @id @default(uuid())
  aggregateType          String
  aggregateId            String
  actorType              String
  actorId                String?
  eventType              String
  payloadAllowlistedJson Json?
  traceId                String
  createdAt              DateTime @default(now())

  @@index([aggregateType, aggregateId])
  @@map("audit_events")
}
