// RepairRelay — Prisma schema (S1 slice: identity foundation).
// Domain scopes propose owned model changes via reviewed patches; integrator owns this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SIMULATED_REPAIRER
  DEMO_ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  displayName  String
  passwordHash String
  role         UserRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disabledAt   DateTime?

  repairRequests RepairRequest[]
  simulatedRepairer SimulatedRepairer?

  @@map("users")
}

enum RepairStatus {
  DRAFT
  INTAKE_SUBMITTED
  DIAGNOSIS_PENDING
  DIAGNOSIS_READY
  DIAGNOSIS_INCONCLUSIVE
  DIAGNOSIS_FAILED
  PARTS_SEARCH_PENDING
  PARTS_AVAILABLE
  PARTS_EMPTY
  PARTS_SEARCH_FAILED
  QUOTES_PENDING
  QUOTES_AVAILABLE
  CONTRACT_SELECTED
  CONTRACT_APPROVED
  REPAIR_IN_PROGRESS
  EVIDENCE_SUBMITTED
  CUSTOMER_REVIEW
  REWORK_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeviceModelConfidence {
  USER_SELECTED
  AI_SUGGESTED
  UNKNOWN
}

enum RepairCategory {
  DISPLAY_REPLACEMENT
  BATTERY_REPLACEMENT
  CHARGING_PORT_REPLACEMENT
  CAMERA_REPLACEMENT
  DIAGNOSTIC_ONLY
  OTHER
}

enum AssetKind {
  INTAKE
  BEFORE
  AFTER
  COMPONENT
  OTHER
}

enum ConfidenceBand {
  LOW
  MEDIUM
  HIGH
  UNASSESSED
}

model RepairRequest {
  id                     String                @id @default(uuid())
  publicReference        String                @unique
  customerId             String
  customer               User                  @relation(fields: [customerId], references: [id])
  deviceBrand            String
  deviceModel            String
  modelIdentifier        String?
  deviceModelConfidence  DeviceModelConfidence @default(USER_SELECTED)
  symptoms               String
  repairCategory         RepairCategory?
  status                 RepairStatus          @default(DRAFT)
  version                Int                   @default(1)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  assets          UploadedAsset[]
  diagnosisReports DiagnosisReport[]
  searchRuns      ProductSearchRun[]

  selectedCandidateId       String?
  selectedChannel3ProductId String?
  selectedQuoteId           String?

  quotes RepairQuote[]

  @@index([customerId])
  @@map("repair_requests")
}

/// Seeded demo actor. demoLabel is fixed to SIMULATED — never presented as a real technician.
model SimulatedRepairer {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  displayName     String
  demoLabel       String   @default("SIMULATED")
  demoDescription String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  quotes RepairQuote[]

  @@map("simulated_repairers")
}

enum QuoteStatus {
  GENERATED
  SELECTED
  SUPERSEDED
  EXPIRED
}

/// Attestation is explicitly simulation data: the seeded actor selected a value,
/// not independent technical verification (PRODUCT-SPEC §6.5).
enum CompatibilityAttestation {
  CONFIRMED_FOR_DEMO
  NOT_CONFIRMED
  REJECTED
}

/// Itemized quote snapshot. Repair-versus-Replace mode: the component is
/// technician-declared — there is no Channel3 part reference on a quote.
model RepairQuote {
  id                      String                  @id @default(uuid())
  repairRequestId         String
  repairRequest           RepairRequest           @relation(fields: [repairRequestId], references: [id])
  repairerId              String
  repairer                SimulatedRepairer       @relation(fields: [repairerId], references: [id])
  version                 Int                     @default(1)
  status                  QuoteStatus             @default(GENERATED)
  componentLabel          String
  compatibilityAttestation CompatibilityAttestation
  compatibilityNotes      String
  partChargeMinor         Int
  labourMinor             Int
  feesMinor               Int                     @default(0)
  taxMinor                Int                     @default(0)
  totalMinor              Int
  currency                String                  @default("USD")
  warrantyDays            Int?
  warrantyText            String
  estimatedDurationHours  Int?
  scopeText               String
  exclusionsText          String
  validUntil              DateTime
  createdAt               DateTime                @default(now())

  @@unique([repairRequestId, repairerId, version])
  @@index([repairRequestId])
  @@map("repair_quotes")
}

enum SearchRunStatus {
  SUCCEEDED
  EMPTY
  FAILED
}

enum OfferAvailability {
  InStock
  OutOfStock
  UNKNOWN
}

enum OfferCondition {
  new
  used
  refurbished
  UNKNOWN
}

/// Search execution record. Query/result metadata only — never a stale-offer cache.
model ProductSearchRun {
  id                   String          @id @default(uuid())
  repairRequestId      String
  repairRequest        RepairRequest   @relation(fields: [repairRequestId], references: [id])
  provider             String          @default("CHANNEL3")
  query                String
  country              String
  currency             String
  language             String
  mode                 String
  providerRequestId    String?
  status               SearchRunStatus
  resultCount          Int
  normalizationVersion Int
  errorCode            String?
  createdAt            DateTime        @default(now())
  completedAt          DateTime?

  candidates ProductCandidate[]

  @@index([repairRequestId])
  @@map("product_search_runs")
}

/// Stable external reference. No offer price/availability/URL stored here as catalog data.
model ProductCandidate {
  id                String          @id @default(uuid())
  searchRunId       String
  searchRun         ProductSearchRun @relation(fields: [searchRunId], references: [id])
  channel3ProductId String
  title             String
  description       String?
  brandNames        Json?
  imageUrl          String?
  createdAt         DateTime        @default(now())

  offerObservations OfferObservation[]

  @@unique([searchRunId, channel3ProductId])
  @@index([channel3ProductId])
  @@map("product_candidates")
}

/// Short-lived observation of an offer at a point in time. Never served after expiresAt.
model OfferObservation {
  id                String           @id @default(uuid())
  productCandidateId String
  productCandidate  ProductCandidate @relation(fields: [productCandidateId], references: [id])
  domain            String
  offerUrl          String
  priceMinor        Int?
  currency          String?
  availability      OfferAvailability @default(UNKNOWN)
  condition         OfferCondition   @default(UNKNOWN)
  observedAt        DateTime
  expiresAt         DateTime

  @@index([productCandidateId])
  @@map("offer_observations")
}

model UploadedAsset {
  id             String    @id @default(uuid())
  repairRequestId String
  repairRequest  RepairRequest @relation(fields: [repairRequestId], references: [id])
  ownerId        String
  assetKind      AssetKind
  storageKey     String    @unique
  mimeType       String
  byteSize       Int
  width          Int
  height         Int
  sha256         String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([repairRequestId])
  @@map("uploaded_assets")
}

model DiagnosisReport {
  id                      String          @id @default(uuid())
  repairRequestId         String
  repairRequest           RepairRequest   @relation(fields: [repairRequestId], references: [id])
  provider                String
  model                   String
  schemaVersion           Int
  deviceModelAssessment   Json
  visibleObservations     Json
  suspectedCauses         Json
  likelyRepairCategory    String?
  confidenceBand          ConfidenceBand
  unknowns                Json
  recommendedQuestions    Json
  limitations             Json
  rawOutputRedacted       String?
  createdAt               DateTime        @default(now())
  supersededAt            DateTime?

  @@index([repairRequestId])
  @@map("diagnosis_reports")
}

/// Append-only by application convention. No secrets, card data, raw images or full PII.
model AuditEvent {
  id                     String   @id @default(uuid())
  aggregateType          String
  aggregateId            String
  actorType              String
  actorId                String?
  eventType              String
  payloadAllowlistedJson Json?
  traceId                String
  createdAt              DateTime @default(now())

  @@index([aggregateType, aggregateId])
  @@map("audit_events")
}
